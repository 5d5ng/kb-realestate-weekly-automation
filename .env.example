# Anthropic
ANTHROPIC_API_KEY=

# Turso (cache DB)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# OpenAI
OPENAI_API_KEY=

# OpenAI Secure MCP Tunnel (ChatGPT 웹에서 로컬 MCP를 붙일 때만)
# CONTROL_PLANE_API_KEY는 모델 호출용 키가 아니라 tunnel-client 런타임 인증용 키입니다.
CONTROL_PLANE_API_KEY=
OPENAI_MCP_TUNNEL_ID=
OPENAI_MCP_TUNNEL_PROFILE=kb-realestate-local
MCP_PYTHON=python3

# Gemini
GEMINI_API_KEY=

# Reporter model routing
REPORTER_TELEGRAM_REPORT_PROVIDER=none
REPORTER_TELEGRAM_REPORT_MODEL=
REPORTER_ALIMTALK_MESSAGE_PROVIDER=none
REPORTER_ALIMTALK_MESSAGE_MODEL=
REPORTER_INSTAGRAM_CAPTION_PROVIDER=none
REPORTER_INSTAGRAM_CAPTION_MODEL=
REPORTER_CARD_NEWS_SCRIPT_PROVIDER=none
REPORTER_CARD_NEWS_SCRIPT_MODEL=
REPORTER_NAVER_BLOG_POST_PROVIDER=none
REPORTER_NAVER_BLOG_POST_MODEL=

# 네이버 뉴스 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 텔레그램
SEND_TELEGRAM_ENABLED=1
SEND_TELEGRAM_PROMPT_FILES_ENABLED=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 솔라피 (SMS 1차 / 알림톡 확장 예정)
SEND_SMS_ENABLED=0
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
SOLAPI_DEFAULT_RECIPIENTS=

# 범용 콘텐츠 패키지 / 게시 계획
CONTENT_PACKAGE_DIR=reports/content_packages
PUBLISHING_PLAN_DIR=reports/publishing_plans

# Instagram Login 게시 MCP
# 공개 계정 정보는 config/instagram_accounts.json에, 토큰은 .env/배포 비밀변수에 둡니다.
# 두 게시 스위치가 모두 1이어야 실제 게시됩니다.
INSTAGRAM_ACCOUNT_REGISTRY=config/instagram_accounts.json
INSTAGRAM_PUBLISHING_ENABLED=0
INSTAGRAM_DDONY_MARBLE_PUBLISHING_ENABLED=0
INSTAGRAM_DDONY_MARBLE_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.instagram.com

# 기존 단일계정 sender.py 호환용. 새 MCP는 계정 레지스트리를 우선합니다.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
SEND_INSTAGRAM_ENABLED=0
META_ACCESS_TOKEN=
META_INSTAGRAM_ID=

# 카카오톡 (나에게 보내기)
SEND_KAKAO_ENABLED=0
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
